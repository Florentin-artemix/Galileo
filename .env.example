# FRONTEND
VITE_API_URL=http://localhost:8080/api

# DATABASE
DATABASE_URL=jdbc:postgresql://localhost:5432/galileo
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-256-bit-secret-your-256-bit-secret-your-256-bit-secret

# CLOUDFLARE R2
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_access_key
CLOUDFLARE_R2_SECRET_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=galileo-bucket
CLOUDFLARE_R2_REGION=auto

# DEEPSEEK
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# QWEN EMBEDDING
QWEN_EMBEDDING_API_KEY=your_qwen_api_key
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSION=1024
